NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
POSTGRES_USER=smart_durian
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=smart_durian
DATABASE_URL=postgresql://smart_durian:local_development_only@127.0.0.1:5432/smart_durian
MONGODB_URI=mongodb://127.0.0.1:27017/smart_durian?replicaSet=rs0&directConnection=true
DB_TIMEOUT_MS=3000
AUTH_MODE=mock
AUTH_TEST_PHONE=0900000000
AUTH_TEST_PASSWORD=LocalTestOnly123!
JWT_SECRET=local-test-only-secret-change-this-32-bytes-minimum
SMS_PROVIDER=mock
# Twilio Verify: điền 3 giá trị từ Console vào .env local, không đưa lên Git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Sửa HTX: Verify Service riêng để không dùng chung OTP với đổi mật khẩu.
TWILIO_HTX_VERIFY_SERVICE_SID=
# Các số tài khoản Manager được phép nhận SMS, phân cách dấu phẩy (tối đa 20).
HTX_SMS_ALLOWED_PHONES=
# SpeedSMS được giữ cho tương thích nhánh cũ; demo hiện tại dùng Twilio Verify.
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SMS_TYPE=4
SPEEDSMS_SENDER=Verify
SMS_ALLOWED_PHONE=
LIVE_SMS_ENABLED=false
SMS_TIMEOUT_MS=10000

# Admin giả lập để duyệt Manager; không đăng ký Admin qua API công khai.
AUTH_TEST_ADMIN_PHONE=0900000001
AUTH_TEST_ADMIN_PASSWORD=LocalAdminOnly123!

# Email thật: điền SMTP_USER/PASSWORD/FROM rồi chuyển EMAIL_PROVIDER=smtp.
EMAIL_PROVIDER=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# MQTT communication: disabled until the operator configures a broker in local .env.
# Resolve every incoming station from the shared Devices store.
MQTT_ENABLED=false
MQTT_BROKER_HOST=<mqtt-broker-host>
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
# Connectivity display threshold only; not an actuator task timeout.
MQTT_OFFLINE_AFTER_MS=1800000
MQTT_RECONNECT_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000

# Demo reference only: paste this ESP32 identifier into POST /api/devices.
# Does not auto-register a Device, provide authentication or restrict incoming stations.
DEMO_DEVICE_STATION_ID=
