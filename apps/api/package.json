{
  "name": "@smart-durian/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "npm run build && concurrently -k \"tsc -p tsconfig.build.json --watch\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test integration",
    "test": "tsc --outDir .test-dist && node --test .test-dist/test",
    "test:integration": "tsc --outDir .integration-dist && node --test .integration-dist/integration/database.integration.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.0",
    "mongodb": "^6.21.0",
    "mqtt": "5.16.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "mqtt-packet": "9.0.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
