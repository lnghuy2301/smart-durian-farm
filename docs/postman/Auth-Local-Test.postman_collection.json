        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.test('OTP is not in this response', () => pm.expect(pm.response.json()).not.to.have.property('otp'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Read mock SMS",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/auth/test/sms?phone_number={{test_phone}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Six digit OTP exists', () => pm.expect(pm.response.json().messages[0].otp).to.match(/^\\d{6}$/));",
              "if (pm.response.code === 200 && pm.response.json().messages.length) { pm.environment.set('otp', pm.response.json().messages[0].otp); }"
            ]
          }
        }
      ]
    },
