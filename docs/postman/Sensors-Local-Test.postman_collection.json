{
  "info": {
    "name": "Smart Durian Farm - Sensors - Nhap JSON",
    "description": "24 request nhập JSON trực tiếp. Enum loại mới chữ thường; unit varchar(16), không còn enum %/oC. data_stream_id metadata là string. Không suy đoán ý nghĩa 302/303; đăng ký theo mapping phần cứng thật. Đọc IOT_METADATA_UPDATE_IMPLEMENTATION.md. Cập nhật 2026-10-07 theo ERD_DIAGRAM/IOT_CORE_TABLES_SPEC; các mã chỉ ví dụ cấu hình, không hằng số hệ thống.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Đăng nhập Chủ Farmer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "http://localhost:3000/api/auth/login",
        "description": "Thay bằng cấu hình AUTH_TEST_PHONE/PASSWORD của mình khi gửi. Copy access_token vào Authorization các request OWNER bằng tay; không export thông tin thật.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000000\",\n  \"password\": \"LocalTestOnly123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 Đăng nhập Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "http://localhost:3000/api/auth/login",
        "description": "Thay bằng AUTH_TEST_ADMIN_PHONE/PASSWORD của mình; copy access_token cho ADMIN.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000001\",\n  \"password\": \"LocalAdminOnly123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Danh sách Sensors",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "PASTE_OWNER_JWT_HERE",
              "type": "string"
            }
          ]
        },
        "url": "http://localhost:3000/api/sensors?limit=20&offset=0",
        "description": "Lọc scope hiện tại trước phân trang. Có thể thêm device_id, sensor_type, status, q (name/stream)."
      }
    },
    {
      "name": "04 Chủ tạo Sensor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "PASTE_OWNER_JWT_HERE",
              "type": "string"
            }
          ]
        },
        "url": "http://localhost:3000/api/sensors",
        "description": "201. Tạo Device theo Devices guide trước, thay UUID 1111... bằng DEVICES.id (không station_id); copy Sensor id mới thay 2222... trong URL. Bỏ ngưỡng khi tạo nhận null/null.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"name\": \"Nhiệt độ không khí\",\n  \"sensor_type\": \"air_temperature\",\n  \"unit\": \"oC\",\n  \"data_stream_id\": \"2\",\n  \"min_threshold\": 10,\n  \"max_threshold\": 40\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
