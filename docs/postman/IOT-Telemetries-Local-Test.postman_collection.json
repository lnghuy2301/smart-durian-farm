          }
        ],
        "url": "http://localhost:3000/api/telemetry/devices/11111111-1111-4111-8111-111111111111/history?from=2026-10-08T00:00:00Z&to=2026-10-07T00:00:00Z",
        "description": "Kỳ vọng400."
      }
    },
    {
      "name": "19 Unknown query field",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_OWNER_JWT"
          }
        ],
        "url": "http://localhost:3000/api/telemetry/devices/11111111-1111-4111-8111-111111111111/history?station_id=DEMO_STATION",
        "description": "Kỳ vọng400; API dùng UUID Device, không station_id."
      }
    },
    {
      "name": "20 No HTTP telemetry injection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
