          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/telemetry/devices/11111111-1111-4111-8111-111111111111/history",
        "description": "Kỳ vọng404; dữ liệu chỉ nhận từ receiver MQTT, không nhập HTTP.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 99,\n  \"unit\": \"C\"\n}",
          "options": {
