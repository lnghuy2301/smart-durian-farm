        "url": "http://localhost:3000/api/actuators",
        "description": "201. Thay Device UUID 1111... và capability 8 bằng mã bơm firmware thật. Bơm có capability riêng, không tự chạy theo van. Copy Actuator id thay 2222...",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"name\": \"Bơm chung tưới và phun\",\n  \"purpose\": \"shared\",\n  \"capability_id\": 8\n}",
          "options": {
