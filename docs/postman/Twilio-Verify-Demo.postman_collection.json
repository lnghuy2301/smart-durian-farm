{
  "info": {
    "name": "Smart Durian Farm - Twilio Verify - Nhap JSON",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Nhập trực tiếp Body → raw → JSON rồi Send. Không có Scripts, biến hay Environment bắt buộc. Thay số ví dụ bằng AUTH_TEST_PHONE. Request 02 gửi SMS thật; sau khi nhận mã, nhập vào otp của request 03. API vẫn dùng tài khoản trong bộ nhớ."
  },
  "item": [
    {
      "name": "01 Dang nhap",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000000\",\n  \"password\": \"LocalTestOnly123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 Gui OTP qua SMS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/auth/forgot-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Nhap OTP va doi mat khau",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/auth/reset-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000000\",\n  \"otp\": \"000000\",\n  \"new_password\": \"ChangedLocalTest123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 Dang nhap bang mat khau moi",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000000\",\n  \"password\": \"ChangedLocalTest123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
