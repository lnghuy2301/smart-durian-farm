          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_FARMER_ACCESS_TOKEN",
            "description": "Giữ Key Authorization; thay phần PASTE bằng access_token của tài khoản."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"farm_id\": \"22222222-2222-4222-8222-222222222222\",\n  \"standard_id\": \"33333333-3333-4333-8333-333333333333\",\n  \"zone_name\": \"Khu A\",\n  \"area_size\": 0.3,\n  \"longitude\": 106.1234567,\n  \"latitude\": 10.7654321\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/zones",
        "description": "Farm phải Accepted qua Farms collection; standard Active qua Standards collection. Thay hai UUID trong JSON. Copy response.id của Zone."
