{
  "info": {
    "name": "Smart Durian Farm - Assignments - Nhap JSON",
    "description": "Đọc ASSIGNMENTS_IMPLEMENTATION.md. Không Scripts/Environment. Thay UUID/JSON/JWT bằng tay. Các luồng Admin/Manager tùy chọn, không chạy tuần tự tất cả nếu request cũ đã Accepted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Login Farmer Owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0913179099\",\n  \"password\": \"LocalTestOnly123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/auth/login",
        "description": "Chủ Farm; thay số và mật khẩu hiện tại của bạn. Lưu JWT chủ riêng."
      },
      "response": []
    },
    {
      "name": "02 Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000001\",\n  \"password\": \"LocalAdminOnly123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/auth/login",
        "description": "Dùng AUTH_TEST_ADMIN_PHONE/PASSWORD trong .env."
      },
      "response": []
    },
    {
      "name": "03 Register Farmer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_name\": \"Farmer nhận phân công\",\n  \"phone_number\": \"0900000002\",\n  \"password\": \"FarmerDemo123!\",\n  \"role\": \"Farmer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/auth/register",
        "description": "Tùy chọn nếu chưa có người nhận. Số mẫu chưa trùng tài khoản, không cần SIM; request này không gửi SMS. Copy response.user.id. Nếu tự nhận việc, bỏ bước này và dùng id chủ."
      },
      "response": []
    },
    {
      "name": "04 Login Farmer Assignee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000002\",\n  \"password\": \"FarmerDemo123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/auth/login",
        "description": "Farmer nhận phân công; lưu JWT người nhận riêng với JWT chủ."
      },
      "response": []
    },
    {
      "name": "05 Create Assignment request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_OWNER_ACCESS_TOKEN",
            "description": "Giữ Key Authorization; thay PASTE bằng access_token của đúng tài khoản."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"55555555-5555-4555-8555-555555555555\",\n  \"end_date\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/zones/44444444-4444-4444-8444-444444444444/assignment-requests",
        "description": "Chủ Farmer mời. Thay UUID Zone trên URL, user_id bằng response.user.id người nhận. Copy response.id lời mời; chưa cấp quyền trước accept. Có thể thêm start_date/end_date ISO có timezone."
      },
      "response": []
    },
    {
      "name": "06 Pending Assignment requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ASSIGNEE_ACCESS_TOKEN",
            "description": "Giữ Key Authorization; thay PASTE bằng access_token của đúng tài khoản."
          }
        ],
        "url": "http://localhost:3000/api/assignment-requests?status=Pending",
        "description": "Người nhận xem lời mời, snapshot và những bên còn cần chấp nhận."
      },
      "response": []
    },
    {
      "name": "07 Accept Assignment request",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ASSIGNEE_ACCESS_TOKEN",
            "description": "Giữ Key Authorization; thay PASTE bằng access_token của đúng tài khoản."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/assignment-requests/11111111-1111-4111-8111-111111111111/approve",
        "description": "URL dùng id lời mời. JWT người nhận. Đủ duyệt mới Accepted; copy response.assignment_id."
      },
      "response": []
    },
