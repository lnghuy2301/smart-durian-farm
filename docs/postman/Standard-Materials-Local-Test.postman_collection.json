{
  "info": {
    "name": "Smart Durian Farm - Standard Materials - Nhap JSON",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Độc lập để test cả tạo danh mục và gắn bridge. Nhập JSON, paste JWT vào Authorization; thay UUID bằng id tạo ở 02/03. Không Scripts/Environment. Không restart giữa các bước vì dữ liệu ở bộ nhớ."
  },
  "item": [
    {
      "name": "01 Login Admin",
      "request": {
        "method": "POST",
        "url": "http://localhost:3000/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"0900000001\",\n  \"password\": \"LocalAdminOnly123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Khớp AUTH_TEST_ADMIN_PHONE/PASSWORD; copy access_token vào Headers request 02..06."
      },
      "response": []
    },
    {
      "name": "02 Create standard",
      "request": {
        "method": "POST",
        "url": "http://localhost:3000/api/standards",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ACCESS_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"DEMO\",\n  \"name\": \"Tieu chuan demo\",\n  \"description\": \"Mo ta mau\",\n  \"certifying_body\": \"To chuc demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Copy id tiêu chuẩn để thay UUID 111... trong 04..06."
      },
      "response": []
    },
    {
      "name": "03 Create material",
      "request": {
        "method": "POST",
        "url": "http://localhost:3000/api/materials",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ACCESS_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Vat tu demo\",\n  \"material_type\": \"Fertilizer\",\n  \"default_dosage\": \"Thong tin mau\",\n  \"unit\": \"kg\",\n  \"quarantine_days\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Copy id vật tư để thay UUID 222... trong 04 và URL 06."
      },
      "response": []
    },
    {
      "name": "04 Add standard material",
      "request": {
        "method": "POST",
        "url": "http://localhost:3000/api/standards/11111111-1111-4111-8111-111111111111/materials",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ACCESS_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"material_id\": \"22222222-2222-4222-8222-222222222222\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Admin. 201 nếu gắn mới; cùng cặp gắn lại: 409. Chỉ body material_id; standard_id ở URL."
      },
      "response": []
    },
    {
      "name": "05 Standard materials",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/standards/11111111-1111-4111-8111-111111111111/materials?limit=20&offset=0",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ACCESS_TOKEN"
          }
        ],
        "description": "User Active. Chỉ trả vật tư đã liên kết. Có thể filter status vật tư, material_type hoặc q. Bao gồm Inactive nếu không filter."
      },
      "response": []
    },
    {
      "name": "06 Remove standard material",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:3000/api/standards/11111111-1111-4111-8111-111111111111/materials/22222222-2222-4222-8222-222222222222",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_ACCESS_TOKEN"
          }
        ],
        "description": "Admin. 204 không body, chỉ bỏ liên kết; tiêu chuẩn/vật tư còn nguyên. Bỏ lần nữa: 404."
      },
      "response": []
    }
  ]
}
